<?xml version="1.0" ?>
<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:c="tracker.control" controllerName="tracker.controller.Main">
  <Page showHeader="false">
    <content>
      <VBox class="shell sapUiResponsiveContentPadding">
        <OverflowToolbar class="brand">
          <Title text="{i18n&gt;appTitle}" level="H1"/>
          <ToolbarSpacer/>
          <ObjectStatus text="{i18n&gt;localOnly}" state="Information"/>
          <Label text="{i18n&gt;theme}" labelFor="themeSelect"/>
          <Select id="themeSelect" selectedKey="{vm&gt;/theme}" change="onThemeChange">
            <core:Item key="sap_horizon_dark" text="{i18n&gt;darkTheme}"/>
            <core:Item key="sap_horizon" text="{i18n&gt;lightTheme}"/>
          </Select>
          <Button text="{i18n&gt;backup}" icon="sap-icon://download" press="onBackup"/>
          <Button text="{i18n&gt;restore}" press="onRestore"/>
        </OverflowToolbar>
        <Text text="{i18n&gt;tagline}" class="subtitle"/>
        <MessageStrip text="{i18n&gt;storageNote}" type="Information" showIcon="true"/>
        <MessageStrip text="{i18n&gt;unverifiedNote}" type="Warning" showIcon="true" class="sapUiTinyMarginTop"/>
        <OverflowToolbar>
          <SegmentedButton selectedKey="{vm&gt;/section}" selectionChange="onNavigate">
            <items>
              <SegmentedButtonItem key="dashboard" text="{i18n&gt;compare}"/>
              <SegmentedButtonItem key="assets" text="{i18n&gt;assets}"/>
              <SegmentedButtonItem key="portfolio" text="{i18n&gt;portfolio}"/>
            </items>
          </SegmentedButton>
          <ToolbarSpacer/>
          <Button text="{i18n&gt;retrievePrices}" icon="sap-icon://synchronize" press="onRetrievePrices" enabled="{= !${vm&gt;/retrieving} }"/>
          <Button text="{i18n&gt;loadDemo}" press="onDemo"/>
          <Button text="{i18n&gt;clearDemo}" press="onClearDemo"/>
        </OverflowToolbar>

        <MessageStrip text="{vm&gt;/retrievalStatus}" visible="{= !!${vm&gt;/retrievalStatus} }" type="Information" showIcon="true"/>

        <VBox visible="{= ${vm&gt;/section} === 'dashboard' }" class="card">
          <Title text="{i18n&gt;comparisonTitle}" level="H2"/>
          <Text text="{i18n&gt;comparisonHelp}"/>
          <MultiComboBox id="selection" width="100%" placeholder="{i18n&gt;selectAssets}" items="{vm&gt;/activeAssets}" selectionFinish="onSelection">
            <core:Item key="{vm&gt;id}" text="{vm&gt;name}"/>
          </MultiComboBox>
          <HBox wrap="Wrap" alignItems="Center">
            <Select selectedKey="{vm&gt;/period}" change="refresh" items="{vm&gt;/periods}">
              <core:Item key="{vm&gt;key}" text="{vm&gt;key}"/>
            </Select>
            <DatePicker value="{vm&gt;/from}" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" placeholder="{i18n&gt;from}" change="refresh" visible="{= ${vm&gt;/period} === 'Custom' }"/>
            <DatePicker value="{vm&gt;/to}" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" placeholder="{i18n&gt;to}" change="refresh" visible="{= ${vm&gt;/period} === 'Custom' }"/>
            <Text text="{vm&gt;/comparisonDates}" class="sapUiSmallMarginBegin"/>
          </HBox>
          <MessageStrip text="{vm&gt;/comparisonStatus}" type="Information" showIcon="true"/>
          <Title text="{i18n&gt;cumulativeDifference}" level="H3"/>
          <Text text="{i18n&gt;differenceHelp}" visible="{= !${vm&gt;/differenceAvailable} }"/>
          <c:PerformanceChart id="differenceChart" chartData="{vm&gt;/differenceChart}" yLabel="pp" tooltip="{i18n&gt;cumulativeDifference}" visible="{vm&gt;/differenceAvailable}"/>
          <Title text="{i18n&gt;cumulativeReturn}" level="H3"/>
          <c:PerformanceChart id="returnsChart" chartData="{vm&gt;/chart}" tooltip="{i18n&gt;chartDescription}"/>
          <Title text="{i18n&gt;summary}" level="H3"/>
          <Table id="summary" items="{vm&gt;/summary}" autoPopinMode="true" growing="true" growingThreshold="30">
            <columns>
              <Column>
                <Text text="{i18n&gt;asset}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;price}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;currency}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;valuationDate}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;periodReturn}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;dataStatus}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;benchmark}"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{vm&gt;name}"/>
                  <Text text="{vm&gt;price}"/>
                  <Text text="{vm&gt;currency}"/>
                  <Text text="{vm&gt;date}"/>
                  <Text text="{vm&gt;performance}"/>
                  <Text text="{vm&gt;status}"/>
                  <Text text="{vm&gt;benchmark}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
          <OverflowToolbar>
            <Title text="{i18n&gt;byPeriod}" level="H3"/>
            <ToolbarSpacer/>
            <Label text="{i18n&gt;sortBy}" labelFor="periodSort"/>
            <Select id="periodSort" selectedKey="{vm&gt;/periodSort}" change="refresh">
              <core:Item key="period" text="{i18n&gt;sortPeriod}"/>
              <core:Item key="asset" text="{i18n&gt;sortAsset}"/>
            </Select>
          </OverflowToolbar>
          <Text text="{i18n&gt;periodHelp}"/>
          <Table id="periodTable" items="{vm&gt;/periodRows}" autoPopinMode="true" growing="true" growingThreshold="14" growingTriggerText="{i18n&gt;showMore}">
            <columns>
              <Column><Text text="{i18n&gt;asset}"/></Column>
              <Column><Text text="{i18n&gt;period}"/></Column>
              <Column><Text text="{i18n&gt;fundReturn}"/></Column>
              <Column><Text text="{i18n&gt;indexReturn}"/></Column>
              <Column><Text text="{i18n&gt;trackingDifference}"/></Column>
              <Column><Text text="{i18n&gt;actualDates}"/></Column>
            </columns>
            <items><ColumnListItem><cells>
              <Text text="{vm&gt;name}"/><Text text="{vm&gt;period}"/><Text text="{vm&gt;fund}"/><Text text="{vm&gt;index}"/><Text text="{vm&gt;difference}"/><Text text="{vm&gt;dates}"/>
            </cells></ColumnListItem></items>
          </Table>
          <Title text="{i18n&gt;calendarYears}" level="H3"/>
          <Table id="years" items="{vm&gt;/years}" autoPopinMode="true" growing="true" growingThreshold="30">
            <columns>
              <Column>
                <Text text="{i18n&gt;asset}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;year}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;priceReturn}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;coverage}"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{vm&gt;name}"/>
                  <Text text="{vm&gt;year}"/>
                  <Text text="{vm&gt;performance}"/>
                  <Text text="{vm&gt;coverage}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
          <OverflowToolbar>
            <Title text="{i18n&gt;dailyHistory}"/>
            <ToolbarSpacer/>
            <Button text="{i18n&gt;exportCSV}" press="onExportCSV"/>
          </OverflowToolbar>
          <Table id="history" items="{vm&gt;/history}" autoPopinMode="true" growing="true" growingThreshold="7" growingTriggerText="{i18n&gt;showMore}">
            <columns>
              <Column>
                <Text text="{i18n&gt;asset}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;date}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;price}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;dataStatus}"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{vm&gt;name}"/>
                  <Text text="{vm&gt;date}"/>
                  <Text text="{vm&gt;price}"/>
                  <Text text="{vm&gt;status}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
        <VBox visible="{= ${vm&gt;/section} === 'assets' }" class="card">
          <OverflowToolbar>
            <Title text="{i18n&gt;assets}"/>
            <ToolbarSpacer/>
            <Button text="{i18n&gt;addAsset}" type="Emphasized" press="onAddAsset"/>
          </OverflowToolbar>
          <List items="{/assets}">
            <CustomListItem>
              <VBox class="sapUiSmallMargin">
                <ObjectIdentifier title="{name}" text="{isin}"/>
                <ObjectStatus text="{currency}"/>
                <Text text="{source}"/>
                <Link text="{i18n&gt;priceSource}" href="{sourceId}" target="_blank" visible="{= ${source} === 'retrieved' }"/>
                <Text text="{fetchedAt}" visible="{= ${source} === 'retrieved' }"/>
                <Text text="{= ${archived} ? ${i18n&gt;archived} : '' }"/>
                <HBox wrap="Wrap">
                  <Button text="{i18n&gt;edit}" press="onEditAsset"/>
                  <Button text="{i18n&gt;archiveToggle}" press="onArchive"/>
                  <Button text="{i18n&gt;retrievePrices}" press="onRetrievePrices" enabled="{= !${vm&gt;/retrieving} &amp;&amp; ${source} !== 'imported' }"/>
                  <Button text="{i18n&gt;importCSV}" press="onImportCSV"/>
                  <Button text="{i18n&gt;remove}" type="Reject" press="onRemoveAsset"/>
                </HBox>
              </VBox>
            </CustomListItem>
          </List>
        </VBox>
        <VBox visible="{= ${vm&gt;/section} === 'portfolio' }" class="card">
          <OverflowToolbar>
            <Title text="{i18n&gt;portfolio}"/>
            <ToolbarSpacer/>
            <Button text="{i18n&gt;addPurchase}" type="Emphasized" press="onAddPurchase"/>
          </OverflowToolbar>
          <MessageStrip text="{i18n&gt;portfolioHelp}" showIcon="true"/>
          <Text text="{vm&gt;/totals}" class="totals sapUiSmallMargin"/>
          <Title text="{i18n&gt;holdings}" level="H3"/>
          <Table id="holdings" items="{vm&gt;/holdings}" autoPopinMode="true" growing="true" growingThreshold="30">
            <columns>
              <Column>
                <Text text="{i18n&gt;asset}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;quantity}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;outlay}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;value}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;gain}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;allocation}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;currency}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;valuationDate}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;dataStatus}"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{vm&gt;name}"/>
                  <Text text="{vm&gt;quantity}"/>
                  <Text text="{vm&gt;cost}"/>
                  <Text text="{vm&gt;value}"/>
                  <Text text="{vm&gt;gain}"/>
                  <Text text="{vm&gt;allocation}"/>
                  <Text text="{vm&gt;currency}"/>
                  <Text text="{vm&gt;valuationDate}"/>
                  <Text text="{vm&gt;source}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
          <Title text="{i18n&gt;portfolioHistory}" level="H3"/>
          <Text text="{i18n&gt;portfolioHistoryHelp}"/>
          <c:PerformanceChart chartData="{vm&gt;/portfolioChart}" yLabel="EUR" tooltip="{i18n&gt;portfolioHistory}"/>
          <Title text="{i18n&gt;yearlyPortfolio}" level="H3"/>
          <Table id="portfolioYears" items="{vm&gt;/portfolioYears}" autoPopinMode="true" growing="true" growingThreshold="30">
            <columns>
              <Column>
                <Text text="{i18n&gt;year}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;currency}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;purchases}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;value}"/>
              </Column>
              <Column>
                <Text text="{i18n&gt;gain}"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{vm&gt;year}"/>
                  <Text text="{vm&gt;currency}"/>
                  <Text text="{vm&gt;purchases}"/>
                  <Text text="{vm&gt;value}"/>
                  <Text text="{vm&gt;gain}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
          <Title text="{i18n&gt;purchases}" level="H3"/>
          <List items="{/purchases}">
            <CustomListItem>
              <HBox wrap="Wrap" alignItems="Center" class="sapUiSmallMargin">
                <ObjectIdentifier title="{assetId}" text="{date}"/>
                <Text text="{quantity}" class="sapUiSmallMargin"/>
                <Text text="{currency}"/>
                <Button text="{i18n&gt;edit}" press="onEditPurchase"/>
                <Button text="{i18n&gt;delete}" press="onDeletePurchase"/>
              </HBox>
            </CustomListItem>
          </List>
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
